# Checkpnt Configuration
# Copy to .env and fill in values

# Backend selection: sqlite | redis
CHECKPNT_BACKEND=sqlite

# SQLite (local development)
CHECKPNT_SQLITE_PATH=./checkpnt_local.db

# Redis (production)
CHECKPNT_REDIS_URL=redis://localhost:6379

# Optional: default TTL for checkpoints (seconds). Unset = persist forever.
# CHECKPNT_DEFAULT_TTL=86400
